{
  "name": "@tiecoms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "migrate": "tsx --env-file=.env src/migrate-cli.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@socket.io/postgres-adapter": "0.5.0",
    "@tiecoms/contracts": "0.1.0",
    "baileys": "7.0.0-rc14",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
