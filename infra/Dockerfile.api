# Imagen de ejecución: el API ya viene empaquetado (sin node_modules ni dependencias nativas).
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN apk add --no-cache tini && addgroup -S tiecoms && adduser -S tiecoms -G tiecoms
COPY --chown=tiecoms:tiecoms api/ /app/
USER tiecoms
EXPOSE 3020
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "--enable-source-maps", "server.js"]
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:3020/api/health/ready >/dev/null || exit 1
