{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chaggu",
  "version": "0.1.0",
  "identifier": "com.chaggu.desktop",
  "build": {
    "beforeDevCommand": "npm -w @tiecoms/web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/build-web.mjs",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss://app.chaggu.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; frame-src https:",
      "devCsp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "chaggu"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "publisher": "CERTILABOR S.A.S.",
    "copyright": "© 2026 CERTILABOR S.A.S.",
    "shortDescription": "La red de trabajo entre empresas",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 360
        },
        "appPosition": {
          "x": 150,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 180
        }
      },
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      },
      "wix": {
        "language": [
          "es-ES",
          "en-US"
        ]
      }
    }
  }
}
