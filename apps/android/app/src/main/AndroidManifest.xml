<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Notas de voz (SPEC-v4 §F): se pide al mantener pulsado el micrófono, con una explicación antes. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Grabar es opcional; RECORD_AUDIO no debe excluir equipos sin micrófono en Play. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Subidas grandes desde «Compartir» (WorkManager en primer plano). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Custom Tabs para el SSO (Android 11+ exige declarar la consulta al navegador). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Tomar la foto de perfil o del grupo con la cámara del sistema (sin permiso CAMERA propio). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".TieComsApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TieComs.Starting"
        tools:targetApi="36">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Direct Share: categoría de los atajos de conversación que salen en la hoja de compartir. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <!-- App Links verificados: requieren /.well-known/assetlinks.json en los tres hosts. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.tiecoms.com" />
                <data android:host="tiecoms.com" />
                <data android:host="www.tiecoms.com" />
                <data android:pathPrefix="/c/" />
                <data android:pathPrefix="/w/" />
                <data android:pathPrefix="/invite/" />
                <data android:pathPrefix="/signup" />
                <data android:pathPrefix="/asuntos" />
                <data android:pathPrefix="/agenda" />
                <data android:pathPrefix="/trazo" />
                <data android:pathPrefix="/whatsapp" />
                <data android:pathPrefix="/share" />
                <data android:pathPrefix="/ajustes" />
            </intent-filter>

            <!-- Retorno del SSO (Google / Microsoft): tiecoms://auth/callback?code=… | ?error=…&message=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tiecoms" android:host="auth" android:pathPrefix="/callback" />
            </intent-filter>

            <!-- Esquema propio de respaldo: tiecoms://c/<id>, tiecoms://w/<id>, tiecoms://invite/<token>, tiecoms://signup?org=<token> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tiecoms" />
            </intent-filter>
        </activity>
        <!-- Compartir hacia TieComs (SPEC-v4 §B): fotos, videos, archivos, texto y enlaces, uno o varios. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:taskAffinity="com.tiecoms.app.share"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TieComs">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <meta-data android:name="android.service.chooser.chooser_target_service" android:value="androidx.sharetarget.ChooserTargetServiceCompat" />
        </activity>

        <!-- Subidas grandes desde «Compartir»: WorkManager en primer plano con notificación de progreso. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Burbuja de conversación (SPEC-v3 §6) -->
        <activity
            android:name=".BubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:label="@string/app_name"
            android:theme="@style/Theme.TieComs" />

        <!-- Acciones de notificación: Responder y Marcar como leído -->
        <receiver
            android:name=".platform.NotificationActionReceiver"
            android:exported="false" />

        <!-- FCM: solo recibe si el build trae google-services.json (si no, Firebase no se inicializa) -->
        <service
            android:name=".platform.TcMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
