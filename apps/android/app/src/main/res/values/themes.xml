<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TieComs" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash del sistema (Android 12+ y compat): fondo crema con el ícono TC; da paso al splash animado. -->
    <style name="Theme.TieComs.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.TieComs</item>
    </style>
</resources>
